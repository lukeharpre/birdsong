---
// Project Birdsong logo. `reverse` is the bird mark alone, white for dark backgrounds.
interface Props { height?: number; reverse?: boolean; class?: string }
const { height = 46, reverse = false, class: cls } = Astro.props;
---
{reverse ? (
  <img class={cls} src="/brand/mark-reverse.png" alt="" width={Math.round((height * 178) / 160)} height={height} />
) : (
  <picture>
    <source srcset="/brand/logo.webp" type="image/webp" />
    <img class={cls} src="/brand/logo.png" alt="" width={Math.round((height * 381) / 120)} height={height} />
  </picture>
)}
