---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";

const uses = [
  ["Trap lines", "Building, replacing and maintaining the traps and bait stations across nine hubs."],
  ["Wildlife monitoring", "Bird counts, coastal monitoring and the gear our counters use."],
  ["Volunteer support", "Training, safety equipment and tools for field days."],
  ["Local paid trappers", "Employing trappers to reach further across Mahurangi West."],
];
---
<Base title="Donate" description="Support predator control and wildlife monitoring in Mahurangi West with a donation.">
  <section class="page-hero donate-hero">
    <div class="wrap grid">
      <div>
        <p class="eyebrow">Donate</p>
        <h1>Every dollar keeps a trap working.</h1>
        <p class="lead">
          Predators like rats, stoats and possums take a heavy toll on native wildlife. Sustained trapping makes safer
          habitat and healthier bush, wetlands and coast.
        </p>
      </div>
      <div class="bank">
        <p class="bank-label">Bank transfer</p>
        <dl>
          <div><dt>Account name</dt><dd>Mahurangi West Pest Inc</dd></div>
          <div><dt>Account number</dt><dd class="acct">06-0483-0894183-00</dd></div>
        </dl>
        <button class="btn" data-copy="06-0483-0894183-00">
          <span class="c-idle"><Icon name="copy" size={18} /> Copy account number</span>
          <span class="c-done"><Icon name="check" size={18} /> Copied</span>
        </button>
        <p class="receipt">
          For a tax receipt, email
          <a href="mailto:mahurangiwestpest@gmail.com?subject=Tax%20receipt">mahurangiwestpest@gmail.com</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap uses-grid">
      <div class="stack" style="--space: 1.4rem">
        <p class="eyebrow reveal">Where it goes</p>
        <h2 class="reveal">Straight into the field.</h2>
        <ul class="uses reveal-stagger">
          {uses.map(([t, b], i) => (
            <li style={`--i:${i}`}><h3>{t}</h3><p>{b}</p></li>
          ))}
        </ul>
      </div>
      <div class="uses-img reveal-scale">
        <Img name="2025-01-wooden-traps-copy.jpg" alt="Stacks of new wooden trap boxes beside a quad bike" sizes="(min-width: 60rem) 45vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="other">
    <div class="wrap other-inner reveal">
      <h2>Can’t give money? Give half an hour.</h2>
      <a href="/get-involved" class="btn sun">Volunteer instead <Icon name="arrow" /></a>
    </div>
  </section>
</Base>

<style>
  .donate-hero {
    background:
      radial-gradient(50rem 30rem at 100% 0%, color-mix(in oklab, var(--pohutukawa) 30%, transparent), transparent 70%),
      var(--kowhai);
  }
  .donate-hero .eyebrow { color: var(--ink); }
  .donate-hero .lead { color: var(--ink); }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .bank {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: 0 40px 70px -40px color-mix(in oklab, var(--ink) 55%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bank { animation: card-in 1.1s var(--ease-out) 0.2s both; }
  }
  @keyframes card-in { from { opacity: 0; transform: translateY(2rem) rotate(2deg); } }
  .bank-label { font-weight: 600; color: var(--bush); text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--step--1); }
  dl { margin: 0; display: grid; gap: 0.8rem; }
  dt { font-size: var(--step--1); color: var(--muted); font-weight: 500; }
  dd { margin: 0; font-weight: 600; font-size: var(--step-1); }
  dd.acct { font-family: var(--display); font-size: clamp(1.7rem, 1rem + 2.6vw, 2.6rem); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .receipt { color: var(--ink-2); font-size: var(--step--1); }
  .receipt a { color: var(--kotare-deep); font-weight: 600; overflow-wrap: anywhere; }
  @media (max-width: 56rem) { .grid { grid-template-columns: 1fr; } }

  .uses-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .uses { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; counter-reset: u; }
  .uses li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    counter-increment: u;
  }
  .uses li::before {
    content: counter(u, decimal-leading-zero);
    grid-row: span 2;
    font-family: var(--display);
    font-style: italic;
    color: var(--kotare);
    font-size: var(--step-1);
  }
  .uses h3 { font-size: var(--step-1); }
  .uses p { color: var(--ink-2); }
  .uses-img { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; }
  .uses-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 56rem) { .uses-grid { grid-template-columns: 1fr; } .uses-img { aspect-ratio: 16 / 11; } }

  .other { padding-bottom: clamp(4rem, 9vw, 7rem); }
  .other-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--paper);
  }
  .other h2 { font-size: var(--step-3); max-width: 18ch; }
</style>
