---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";

const roles = [
  { title: "Planting and weeding", body: "Help out on native planting days, weed cafés and weed control.", colour: "var(--fern)" },
  { title: "Monitoring and citizen science", body: "Seasonal bird counts, Coast Guardians coastal monitoring and other projects.", colour: "var(--sky)" },
  { title: "Community events", body: "Displays, working bees, fundraising and educational activities.", colour: "var(--buff)" },
  { title: "Admin and comms", body: "Behind-the-scenes organising and communications that keep projects and volunteers going.", colour: "var(--paper-2)" },
  { title: "Business and sponsors", body: "Support the project as a sponsor or partner. Talk to us about what suits your business.", colour: "var(--kowhai)" },
  { title: "Fundraise for us", body: "Run your own event or challenge and raise money for Project Birdsong.", colour: "color-mix(in oklab, var(--pohutukawa) 30%, var(--paper))" },
];

const audiences = [
  ["Individuals", "Give an hour, a season or more. No experience needed."],
  ["Families", "Come along to a planting day together."],
  ["Businesses", "Sponsor a project or back an event."],
  ["Community groups", "Bring your group along to a working bee."],
];

const why = [
  "Help bring native birds back to the peninsula",
  "Help restore the Mahurangi West peninsula",
  "Get practical conservation experience and training",
  "Meet people who care about the same things",
  "Spend time outdoors somewhere beautiful",
  "Build experience for your CV, with references where appropriate",
];
---
<Base title="Get involved" description="Volunteer with Project Birdsong: planting, weeding, bird counts, events and more. No experience needed.">
  <section class="page-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Volunteer with us</p>
        <h1>Make a difference in Mahurangi West.</h1>
        <p class="lead">
          Volunteers are at the heart of everything we do. Whether you have a few hours a month or more to give, no
          experience is needed, just a willingness to help and learn.
        </p>
        <div class="cta">
          <a href="/contact" class="btn">Join the team <Icon name="arrow" /></a>
          <a href="#half-hour" class="btn ghost">Got half an hour?</a>
        </div>
      </div>
      <div class="hero-photos">
        <Img name="2025-03-digging_planting.jpg" alt="Volunteers planting natives along a roadside bank" sizes="(min-width: 60rem) 22vw, 50vw" eager class="p1" />
        <Img name="2026-06-1000034899-1.jpg" alt="Volunteers gathered at Huawai Bay" sizes="(min-width: 60rem) 22vw, 50vw" eager class="p2" />
      </div>
    </div>
  </section>

  <section class="section-sm audiences">
    <ul class="wrap aud reveal-stagger">
      {audiences.map(([who, line], i) => (
        <li style={`--i:${i}`}><strong>{who}</strong><span>{line}</span></li>
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Ways to help</p>
        <h2>Pick what suits you.</h2>
      </div>
      <ul class="roles reveal-stagger">
        {roles.map((r, i) => (
          <li style={`--i:${i}; --c:${r.colour}`}>
            <span class="idx">0{i + 1}</span>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="half-hour" class="section micro">
    <div class="wrap micro-grid">
      <div class="stack reveal" style="--space: 1.3rem">
        <p class="eyebrow">Micro-volunteering</p>
        <h2>Got half an hour?</h2>
        <p class="lead">
          Many hands make light work. Small, regular contributions keep our projects going without anyone feeling
          overloaded.
        </p>
        <a href="/contact" class="btn sun">Put your hand up <Icon name="arrow" /></a>
      </div>
      <ul class="tasks reveal-stagger">
        <li style="--i:0"><span class="time">30 min</span><div><h3>Count birds</h3><p>Half an hour at your station, once a season.</p></div></li>
        <li style="--i:1"><span class="time">1 hour</span><div><h3>Join a weed café</h3><p>Weeding, mulching and watering young natives.</p></div></li>
        <li style="--i:2"><span class="time"><Icon name="leaf" size={22} /></span><div><h3>Join a planting day</h3><p>Help plant natives, from the Jamieson Bay esplanade to Huawai Bay.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap why-grid">
      <div class="why-img reveal-scale">
        <Img name="2024-05-bbq-time_planters-break.jpg" alt="Volunteers taking a barbecue break at the Jamieson Bay planting bee" sizes="(min-width: 60rem) 45vw, 100vw" />
      </div>
      <div class="stack" style="--space: 1.4rem">
        <p class="eyebrow reveal">Why volunteer</p>
        <h2 class="reveal">Give back to the place you love.</h2>
        <ul class="why reveal-stagger">
          {why.map((w, i) => <li style={`--i:${i}`}>{w}</li>)}
        </ul>
        <p class="reveal">
          Don’t see a role that fits? Get in touch anyway and we’ll find a way for you to be involved.
        </p>
      </div>
    </div>
  </section>

  <section id="newsletter" class="join">
    <div class="wrap join-inner reveal">
      <h2>Together we can bring the birdsong back to Mahurangi West.</h2>
      <div class="join-cta">
        <a href="/contact" class="btn sun">Get in touch <Icon name="arrow" /></a>
        <a href="https://preview.mailerlite.io/forms/2346067/193744657051551642/share" class="btn ghost" rel="noopener">Join our newsletter</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero-photos {
    position: relative;
    aspect-ratio: 1;
  }
  .hero-photos :global(img) {
    position: absolute;
    object-fit: cover;
    box-shadow: 0 30px 60px -30px color-mix(in oklab, var(--ink) 45%, transparent);
  }
  .hero-photos :global(.p1) {
    width: 62%;
    height: 80%;
    left: 0;
    top: 0;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
  }
  .hero-photos :global(.p2) {
    width: 55%;
    aspect-ratio: 1;
    right: 0;
    bottom: 0;
    border-radius: 50%;
    border: 6px solid var(--paper);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-photos :global(img) { animation: pop 1.2s var(--ease-out) both; }
    .hero-photos :global(.p2) { animation-delay: 0.25s; }
  }
  @keyframes pop { from { opacity: 0; transform: translateY(2rem) scale(0.94); } }
  @media (max-width: 56rem) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photos { max-width: 26rem; }
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .roles li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-height: 15rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--c);
    transition: transform 0.5s var(--ease-spring), box-shadow 0.4s;
  }
  .roles li:hover {
    transform: translateY(-6px) rotate(-0.6deg);
    box-shadow: 0 30px 50px -30px color-mix(in oklab, var(--ink) 50%, transparent);
  }
  .idx { font-family: var(--display); font-style: italic; }
  .roles h3 { font-size: var(--step-2); margin-top: auto; }
  .roles p { color: var(--ink-2); }
  @media (max-width: 60rem) { .roles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 38rem) { .roles { grid-template-columns: 1fr; } .roles li { min-height: 0; } }

  .section-sm { padding-block: clamp(1.5rem, 4vw, 3rem); }
  .aud {
    list-style: none;
    padding: 0;
    margin-block: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .aud li {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1.5px var(--line);
  }
  .aud strong { font-family: var(--display); font-size: var(--step-1); }
  .aud span { color: var(--ink-2); font-size: var(--step--1); }
  @media (max-width: 60rem) { .aud { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 34rem) { .aud { grid-template-columns: 1fr; } }

  .micro {
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-lg);
    margin-inline: clamp(0.5rem, 1.5vw, 1.25rem);
  }
  .micro .eyebrow { color: var(--kowhai); }
  .micro .lead { color: color-mix(in oklab, var(--paper) 78%, transparent); }
  .micro-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .tasks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .tasks li {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
  }
  .time {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--kowhai);
    font-family: var(--display);
    font-weight: 600;
    text-align: center;
    line-height: 1.1;
  }
  .tasks h3 { font-size: var(--step-1); }
  .tasks p { color: var(--ink-2); margin-top: 0.2rem; }
  @media (max-width: 56rem) { .micro-grid { grid-template-columns: 1fr; } }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .why-img { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; }
  .why-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .why { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .why li {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    font-size: var(--step-1);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .why li::before { content: "✦"; color: var(--kotare); font-size: 0.9em; }
  @media (max-width: 56rem) { .why-grid { grid-template-columns: 1fr; } .why-img { aspect-ratio: 16 / 11; } }

  .join { padding-bottom: clamp(4rem, 9vw, 7rem); }
  .join-inner {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(30rem 20rem at 100% 100%, color-mix(in oklab, var(--kowhai) 60%, transparent), transparent 70%),
      var(--sky);
  }
  .join h2 { font-size: var(--step-4); max-width: 20ch; }
  .join-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
