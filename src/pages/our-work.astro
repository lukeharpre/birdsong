---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import SongLine from "../components/SongLine.astro";

const predators = [
  {
    name: "Mustelids",
    kinds: "Stoats · ferrets · weasels",
    body: "Predators of native birds, eggs, lizards and insects. Weasels will take prey much larger than themselves, and nesting birds are easy targets.",
    colour: "var(--pohutukawa)",
  },
  {
    name: "Possums",
    kinds: "Brought from Australia in the 1800s",
    body: "At high numbers their browsing strips the canopy and understorey. They also compete with and eat native wildlife, which never evolved defences against them.",
    colour: "var(--kotare)",
  },
  {
    name: "Rats",
    kinds: "Ship rats · Norway rats · kiore",
    body: "Omnivores that eat birds, eggs, chicks, seeds, snails, lizards, wētā, fruit and flowers. They’re partly responsible for the decline of many native species.",
    colour: "var(--bush)",
  },
];

const traps = [
  { name: "Timms", for: "possums", note: "A bite-sized piece of apple on the movable bar inside." },
  { name: "Victor", for: "rats", note: "Two types of rodent trap are used across the hubs." },
  { name: "DOC200", for: "stoats, ferrets and weasels", note: "The Department of Conservation’s humane kill trap." },
];

const hubs = [
  ["1", "Ian C"],
  ["2", "Jeff M (Jamieson) · Lyn L (Opahi)"],
  ["3", "Hugh K"],
  ["4", "Mike N"],
  ["5", null],
  ["6", "Hugh K"],
  ["7", "Steph H"],
  ["8", null],
  ["9", "Mick C"],
];
---
<Base title="Our work" description="Predator control, pest plant clearing, bird counts and coastal monitoring across the Mahurangi West peninsula.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Our work</p>
      <h1>Predator free, one trap line at a time.</h1>
      <p class="lead">
        Our aim is to rid the Mahurangi West peninsula of pest animals. We target possums, mustelids and rodents, in
        line with Pest Free Auckland, and clear the weeds that smother native bush.
      </p>
      <nav class="jump" aria-label="On this page">
        <a href="#predators" class="chip">Predators</a>
        <a href="#traps" class="chip">Traps</a>
        <a href="#hubs" class="chip">Nine hubs</a>
        <a href="#birds" class="chip">Bird counts</a>
        <a href="#coast" class="chip">Coast Guardians</a>
        <a href="#buffer" class="chip">Pest plants</a>
      </nav>
    </div>
  </section>

  <!-- predators -->
  <section id="predators" class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">The three we’re after</p>
        <h2>Why these predators have to go.</h2>
      </div>
      <ul class="predators reveal-stagger">
        {predators.map((p, i) => (
          <li style={`--i:${i}; --c:${p.colour}`}>
            <span class="no" aria-hidden="true">✕</span>
            <h3>{p.name}</h3>
            <p class="kinds">{p.kinds}</p>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- traps -->
  <section id="traps" class="section traps">
    <div class="wrap traps-grid">
      <div class="traps-img reveal-scale">
        <Img name="2022-05-img_20201206_093147-edited-1.jpg" alt="A piece of apple skewered on the bar inside a yellow possum trap" sizes="(min-width: 60rem) 45vw, 100vw" />
      </div>
      <div class="stack" style="--space: 1.5rem">
        <p class="eyebrow reveal">Humane traps</p>
        <h2 class="reveal">Checked, reset and re-baited by volunteers.</h2>
        <ol class="trap-list reveal-stagger">
          {traps.map((t, i) => (
            <li style={`--i:${i}`}>
              <strong>{t.name}</strong>
              <span>for {t.for}</span>
              <p>{t.note}</p>
            </li>
          ))}
        </ol>
        <div class="trapnz reveal">
          <h3>Every catch goes into Trap.NZ</h3>
          <p>
            We log trap locations, what was caught and which bait was used. Our data joins thousands of other
            community projects, building a picture of how Aotearoa is tracking towards Predator Free 2050.
          </p>
          <a href="https://trap.nz/" class="link-arrow" rel="noopener">Visit Trap.NZ <Icon name="external" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- hubs -->
  <section id="hubs" class="section">
    <div class="wrap hubs-grid">
      <div class="stack" style="--space: 1.4rem">
        <p class="eyebrow reveal">Coverage</p>
        <h2 class="reveal">Nine hubs, 3,500 hectares.</h2>
        <p class="lead reveal">
          With help from Auckland Council’s biodiversity team we split the peninsula into nine hubs. Each has its own
          volunteers and landowners, looked after by a hub coordinator. Over 80 trapping volunteers work across them.
        </p>
        <ul class="hub-list reveal-stagger">
          {hubs.map(([n, who], i) => (
            <li style={`--i:${i}`} class:list={{ vacant: !who }}>
              <span class="hub-n">{n}</span>
              {who ? <span>{who}</span> : <a href="/contact">Coordinator wanted. Could it be you?</a>}
            </li>
          ))}
        </ul>
      </div>
      <figure class="map reveal">
        <Img name="2025-09-9-hubs_rds_hubs_named.png" alt="Map of Mahurangi West showing the nine coloured trapping hubs" sizes="(min-width: 60rem) 50vw, 100vw" />
        <figcaption>The Mahurangi West Pest operational area and its nine hubs.</figcaption>
      </figure>
    </div>
  </section>

  <!-- birds -->
  <section id="birds" class="section birds">
    <div class="wrap">
      <div class="birds-grid">
        <div class="stack" style="--space: 1.4rem">
          <p class="eyebrow reveal">Monitoring</p>
          <h2 class="reveal">Counting birds tells us if it’s working.</h2>
          <p class="lead reveal">
            Any group doing pest control needs a benchmark of its birdlife, then regular counts to see whether
            trapping is making a difference.
          </p>
          <p class="reveal">
            Our counters were trained in December 2020 by Ngaire Wallen of the Takatu Landcare Group. Each season,
            around 20 volunteers spend half an hour at each of our 20 stations, recording every bird seen or heard.
          </p>
          <p class="reveal">
            Since autumn 2022 the counts have gone into Trap.NZ, and onto eBird, run by the Cornell Lab of
            Ornithology, which also feeds the New Zealand Bird Atlas.
          </p>
        </div>
        <div class="birds-media reveal">
          <Img name="2021-02-img_20201215_101035-1.jpg" alt="New bird counters with binoculars at a picnic table by the estuary" sizes="(min-width: 60rem) 40vw, 100vw" />
          <div class="spec">
            <SongLine seed={33} height={110} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- coast -->
  <section id="coast" class="section">
    <div class="wrap coast">
      <div class="coast-copy stack reveal" style="--space: 1.3rem">
        <p class="eyebrow">New in 2026</p>
        <h2>Coast Guardians</h2>
        <p class="lead">
          Our first project under a three-year partnership with Auckland Council. Volunteers adopt a stretch of the
          Mahurangi West coastline and monitor it through the breeding season.
        </p>
        <ul class="ticks">
          <li>Record kororā (little blue penguins), nesting shorebirds and other coastal wildlife</li>
          <li>Note threats like predator activity and human disturbance</li>
          <li>Training with Auckland Council community ranger Jared Anderson</li>
        </ul>
        <a href="mailto:mahurangiwestpest@gmail.com?subject=Coast%20Guardians" class="btn light">Register your interest <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- buffer -->
  <section id="buffer" class="section buffer">
    <div class="wrap buffer-grid">
      <div class="stack" style="--space: 1.4rem">
        <p class="eyebrow reveal">Pest plants</p>
        <h2 class="reveal">The Buffer Zone programme.</h2>
        <p class="lead reveal">
          A park buffer zone is the 500 metres around a park with special ecological values. Properties around
          Mahurangi Regional Park are in one.
        </p>
        <p class="reveal">
          Auckland Council controls pest plants inside the park, and they need controlling on the land around it too.
          Council does the first round on climbing and bushy asparagus; landowners follow up, and deal with woolly
          nightshade, moth plant and wild ginger themselves. We can help with advice and hands.
        </p>
        <div class="cta-row reveal">
          <a href="/pest-plants" class="btn">Pest plant guide <Icon name="arrow" /></a>
          <a href="/contact" class="btn ghost">Are you in the buffer zone?</a>
        </div>
      </div>
      <div class="buffer-img reveal">
        <Img name="2022-11-allisonmilne_ginger_aspargusfern.jpg" alt="Wild ginger and climbing asparagus smothering bush" sizes="(min-width: 60rem) 40vw, 100vw" />
        <p class="credit">Wild ginger and climbing asparagus. Photo: Allison Milne</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .jump a {
    text-decoration: none;
    transition: background-color 0.25s, transform 0.3s var(--ease-spring);
  }
  .jump a:hover { background: var(--kowhai); transform: translateY(-2px); }

  .predators {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .predators li {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    overflow: hidden;
  }
  .predators li::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: var(--c);
  }
  .no {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .predators h3 { font-size: var(--step-3); }
  .kinds { font-weight: 600; color: var(--bush); font-size: var(--step--1); letter-spacing: 0.04em; }
  .predators p:last-child { color: var(--ink-2); }
  @media (max-width: 56rem) { .predators { grid-template-columns: 1fr; } }

  .traps { background: var(--sky); border-radius: var(--radius-lg); margin-inline: clamp(0.5rem, 1.5vw, 1.25rem); }
  .traps-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .traps-img { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; }
  .traps-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .trap-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .trap-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.8rem;
    align-items: baseline;
    padding: 1rem 1.25rem;
    background: var(--paper);
    border-radius: var(--radius);
  }
  .trap-list strong { font-family: var(--display); font-size: var(--step-2); }
  .trap-list span { font-weight: 600; color: var(--kotare-deep); }
  .trap-list p { grid-column: 1 / -1; color: var(--ink-2); font-size: var(--step--1); }
  .trapnz { display: grid; gap: 0.6rem; padding-top: 0.5rem; }
  .trapnz h3 { font-size: var(--step-1); }
  @media (max-width: 56rem) {
    .traps-grid { grid-template-columns: 1fr; }
    .traps-img { aspect-ratio: 16 / 11; }
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .hub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .hub-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem 0.6rem 0.6rem;
    border-radius: 999px;
    background: var(--paper-2);
    font-weight: 500;
    font-size: var(--step--1);
  }
  .hub-n {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-weight: 600;
  }
  .hub-list .vacant { background: var(--kowhai); grid-column: span 2; }
  .hub-list .vacant .hub-n { background: var(--pohutukawa); }
  .hub-list .vacant a { font-weight: 600; }
  .map { margin: 0; position: sticky; top: 6rem; }
  .map :global(img) { border-radius: var(--radius-lg); box-shadow: 0 30px 60px -30px color-mix(in oklab, var(--ink) 40%, transparent); }
  .map figcaption { margin-top: 0.8rem; font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 56rem) {
    .hubs-grid { grid-template-columns: 1fr; }
    .map { position: static; }
    .hub-list { grid-template-columns: 1fr; }
    .hub-list .vacant { grid-column: auto; }
  }

  .birds { background: color-mix(in oklab, var(--fern) 35%, var(--paper)); }
  .birds-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .birds-media { position: relative; }
  .birds-media :global(img) { border-radius: 999px 999px var(--radius-lg) var(--radius-lg); aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .spec {
    position: absolute;
    left: -8%;
    right: 10%;
    bottom: 8%;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: 0 20px 50px -20px color-mix(in oklab, var(--ink) 45%, transparent);
  }
  @media (max-width: 56rem) {
    .birds-grid { grid-template-columns: 1fr; }
    .spec { left: 4%; right: 4%; }
  }

  .coast {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: clamp(2rem, 6vw, 5rem);
    color: var(--paper);
    background:
      radial-gradient(30rem 20rem at 100% 0%, color-mix(in oklab, var(--sky) 40%, transparent), transparent 70%),
      linear-gradient(160deg, var(--kotare), var(--kotare-deep));
  }
  .coast .eyebrow { color: var(--kowhai); }
  .coast .lead { color: color-mix(in oklab, var(--paper) 88%, transparent); }
  .coast-copy { max-width: 42rem; }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .ticks li { display: flex; gap: 0.7rem; }
  .ticks li::before { content: "✓"; color: var(--kowhai); font-weight: 700; }

  .buffer-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .buffer-img :global(img) { border-radius: var(--radius-lg); aspect-ratio: 1; object-fit: cover; width: 100%; }
  .credit { margin-top: 0.7rem; font-size: var(--step--1); color: var(--muted); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 56rem) { .buffer-grid { grid-template-columns: 1fr; } }
</style>
