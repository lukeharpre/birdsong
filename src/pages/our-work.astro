---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import SongLine from "../components/SongLine.astro";

const why = [
  ["Food and shelter", "Native trees and shrubs feed birds and bats with fruit, nectar and insects, and give them somewhere to roost and nest."],
  ["Weeds smother it", "Climbing asparagus, moth plant, wild ginger and woolly nightshade crowd out young natives and choke the canopy."],
  ["Restore it and they return", "Clear the weeds and plant natives, and the bush can regrow. As it does, the birdsong comes back."],
];

const restore = [
  {
    title: "Planting days",
    body: "Volunteers plant natives along the coast, from the Jamieson Bay esplanade to Huawai Bay.",
  },
  {
    title: "Huawai Bay reforestation",
    body: "Clearing invasive weeds and unwanted trees, then replanting with natives. More than 60 people planted about 1,300 natives at one working bee.",
  },
  {
    title: "Morehu whānau land",
    body: "Pine removal and native planting at Jamieson Bay, supported by a 2021 Rodney Healthy Harbours grant.",
  },
  {
    title: "Roadside planting",
    body: "Replanting road edges at Opahi Bay and along Mahurangi West roads.",
  },
  {
    title: "Weed cafés",
    body: "One hour of weeding, mulching and watering young natives, alongside your neighbours.",
  },
];
---
<Base title="Our work" description="How Project Birdsong understands, restores and protects native bird habitat across the Mahurangi West peninsula.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Our work</p>
      <h1>Understand, restore, protect.</h1>
      <p class="lead">
        Native bush feeds and shelters the birds of Mahurangi West. We study the birdlife, restore the habitat it
        depends on and look after what has been restored.
      </p>
      <nav class="jump" aria-label="On this page">
        <a href="#why" class="chip">Why habitat matters</a>
        <a href="#understand" class="chip">Understand</a>
        <a href="#restore" class="chip">Restore</a>
        <a href="#protect" class="chip">Protect</a>
      </nav>
    </div>
  </section>

  <!-- why habitat matters -->
  <section id="why" class="section why">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Why habitat matters</p>
        <h2>No bush, no birdsong.</h2>
      </div>
      <ol class="why-list reveal-stagger">
        {why.map(([t, b], i) => (
          <li style={`--i:${i}`}>
            <span class="no" aria-hidden="true">{i + 1}</span>
            <h3>{t}</h3>
            <p>{b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- understand -->
  <section id="understand" class="section birds">
    <div class="wrap">
      <div class="birds-grid">
        <div class="stack" style="--space: 1.4rem">
          <p class="eyebrow reveal">Understand</p>
          <h2 class="reveal">Counting birds tells us what’s coming back.</h2>
          <p class="lead reveal">
            We have 20 bird monitoring stations across the peninsula. Each season around 20 volunteer counters spend
            half an hour at each one, recording every bird they see or hear.
          </p>
          <p class="reveal">
            Our counters were trained in December 2020 by Ngaire Wallen of the Takatu Landcare Group. The counts go to
            eBird, run by the Cornell Lab of Ornithology, and on to the New Zealand Bird Atlas. They are also recorded
            in Trap.NZ.
          </p>
          <a href="/stories/kaka-making-a-comeback-in-mahurangi-west" class="link-arrow reveal">Kākā are back <Icon name="arrow" size={18} /></a>
        </div>
        <div class="birds-media reveal">
          <Img name="2021-02-img_20201215_101035-1.jpg" alt="New bird counters with binoculars at a picnic table by the estuary" sizes="(min-width: 60rem) 40vw, 100vw" />
          <div class="spec">
            <SongLine seed={33} height={110} />
          </div>
        </div>
      </div>

      <div class="understand-more">
        <article class="flagship reveal">
          <p class="eyebrow">Flagship species</p>
          <h3>Matuku-hūrepo</h3>
          <p class="latin">Australasian bittern</p>
          <p>
            A shy wetland bird, more often heard than seen. The matuku-hūrepo is the flagship species for our work.
          </p>
        </article>
        <article class="bats reveal">
          <div class="bats-img">
            <Img name="2022-11-brian_batdevice.jpg" alt="Brian Bramell placing an acoustic bat logger on a tree at Te Muri" sizes="(min-width: 60rem) 20vw, 100vw" />
          </div>
          <div class="bats-copy">
            <p class="eyebrow">Pekapeka</p>
            <h3>Listening for bats</h3>
            <p>
              With a grant from Auckland Council we use acoustic listening devices to find pekapeka-tou-roa
              (long-tailed bats) on the peninsula, so we can help protect them and their roost trees.
            </p>
            <a href="/stories/grant-to-find-research-and-protect-our-native-bat" class="link-arrow">Read more <Icon name="arrow" size={18} /></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- coast -->
  <section id="coast" class="section">
    <div class="wrap coast">
      <div class="coast-copy stack reveal" style="--space: 1.3rem">
        <p class="eyebrow">New in 2026</p>
        <h2>Coast Guardians</h2>
        <p class="lead">
          Our first project under a three-year partnership with Auckland Council. Volunteers adopt a stretch of the
          Mahurangi West coastline and monitor it through the breeding season.
        </p>
        <ul class="ticks">
          <li>Record kororā (little blue penguins), nesting shorebirds and other coastal wildlife</li>
          <li>Note threats such as human disturbance</li>
          <li>Training with Auckland Council community ranger Jared Anderson</li>
        </ul>
        <a href="mailto:mahurangiwestpest@gmail.com?subject=Coast%20Guardians" class="btn light">Register your interest <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- restore -->
  <section id="restore" class="section">
    <div class="wrap restore-grid">
      <div class="stack" style="--space: 1.4rem">
        <p class="eyebrow reveal">Restore</p>
        <h2 class="reveal">Swapping weeds for natives.</h2>
        <p class="lead reveal">
          Volunteers, landowners and whānau clear pest plants and replant with natives, so the bush can regrow.
        </p>
        <ul class="projects reveal-stagger">
          {restore.map((r, i) => (
            <li style={`--i:${i}`}><h3>{r.title}</h3><p>{r.body}</p></li>
          ))}
        </ul>
      </div>
      <div class="restore-img reveal-scale">
        <Img name="2024-05-flaxessteepbank_grantp_petel_peterd.jpg" alt="Volunteers planting flaxes on a steep bank above the bay" sizes="(min-width: 60rem) 40vw, 100vw" />
      </div>
    </div>
  </section>

  <!-- buffer -->
  <section id="buffer" class="section buffer">
    <div class="wrap buffer-grid">
      <div class="stack" style="--space: 1.4rem">
        <p class="eyebrow reveal">Pest plants</p>
        <h2 class="reveal">The Buffer Zone programme.</h2>
        <p class="lead reveal">
          The buffer zone is the 500 metres around Mahurangi Regional Park. Pest plants here spread into the park, so
          they need controlling on the land around it too.
        </p>
        <p class="reveal">
          We help landowners in the zone control climbing asparagus, moth plant, woolly nightshade and wild ginger,
          with advice and hands.
        </p>
        <div class="cta-row reveal">
          <a href="/pest-plants" class="btn">Pest plant guide <Icon name="arrow" /></a>
          <a href="/contact" class="btn ghost">Are you in the buffer zone?</a>
        </div>
      </div>
      <div class="buffer-img reveal">
        <Img name="2022-11-allisonmilne_ginger_aspargusfern.jpg" alt="Wild ginger and climbing asparagus smothering bush" sizes="(min-width: 60rem) 40vw, 100vw" />
        <p class="credit">Wild ginger and climbing asparagus. Photo: Allison Milne</p>
      </div>
    </div>
  </section>

  <!-- protect -->
  <section id="protect" class="section">
    <div class="wrap protect">
      <div class="protect-head reveal">
        <p class="eyebrow">Protect</p>
        <h2>Looking after what’s been restored.</h2>
        <p class="lead">
          Restored bush needs care for years. We work with Auckland Council so the gains last, inside the regional
          parks and across the private land around them.
        </p>
      </div>
      <ul class="protect-list reveal-stagger">
        <li style="--i:0">
          <h3>A three-year partnership</h3>
          <p>A memorandum of understanding with Auckland Council to restore and protect Mahurangi West and its regional parks.</p>
        </li>
        <li style="--i:1">
          <h3>The Buffer Zone</h3>
          <p>Working with Auckland Council and landowners to keep pest plants out of Mahurangi Regional Park.</p>
        </li>
        <li style="--i:2">
          <h3>Long-term monitoring</h3>
          <p>Bird counts and coastal monitoring show how restored areas are doing year after year.</p>
        </li>
        <li style="--i:3" class="proof">
          <strong>16,000+</strong>
          <p>pest catches since 2019</p>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .jump a {
    text-decoration: none;
    transition: background-color 0.25s, transform 0.3s var(--ease-spring);
  }
  .jump a:hover { background: var(--kowhai); transform: translateY(-2px); }

  .why-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .why-list li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
  }
  .why-list li:nth-child(2) { background: var(--sky); }
  .why-list li:nth-child(3) { background: color-mix(in oklab, var(--fern) 45%, var(--paper)); }
  .no {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-weight: 600;
  }
  .why-list h3 { font-size: var(--step-2); }
  .why-list p { color: var(--ink-2); }
  @media (max-width: 56rem) { .why-list { grid-template-columns: 1fr; } }

  .understand-more {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .flagship, .bats {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }
  .flagship { display: grid; gap: 0.6rem; align-content: start; background: var(--kowhai); }
  .flagship .eyebrow { color: var(--ink); }
  .flagship h3 { font-size: var(--step-3); }
  .latin { font-style: italic; color: var(--ink-2); }
  .bats { display: grid; grid-template-columns: 0.8fr 1fr; gap: clamp(1rem, 3vw, 2rem); align-items: center; }
  .bats-img { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 5; }
  .bats-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .bats-copy { display: grid; gap: 0.75rem; justify-items: start; }
  .bats-copy p:not(.eyebrow) { color: var(--ink-2); }
  @media (max-width: 56rem) {
    .understand-more { grid-template-columns: 1fr; }
    .bats { grid-template-columns: 1fr; }
    .bats-img { aspect-ratio: 16 / 10; }
  }

  .restore-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .projects { list-style: none; padding: 0; margin: 0; display: grid; }
  .projects li {
    display: grid;
    gap: 0.3rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .projects h3 { font-size: var(--step-1); }
  .projects p { color: var(--ink-2); }
  .restore-img { position: sticky; top: 7rem; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; }
  .restore-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 56rem) {
    .restore-grid { grid-template-columns: 1fr; }
    .restore-img { position: static; aspect-ratio: 16 / 11; }
  }

  .protect {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--paper);
  }
  .protect-head { display: grid; gap: 1.2rem; max-width: 46rem; }
  .protect .eyebrow { color: var(--kowhai); }
  .protect .lead { color: color-mix(in oklab, var(--paper) 80%, transparent); }
  .protect-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .protect-list li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--paper) 8%, transparent);
  }
  .protect-list h3 { font-size: var(--step-1); }
  .protect-list p { color: color-mix(in oklab, var(--paper) 78%, transparent); }
  .protect-list .proof { background: var(--kowhai); color: var(--ink); align-content: end; }
  .proof strong { font-family: var(--display); font-size: var(--step-4); line-height: 1; }
  .protect-list .proof p { color: var(--ink); font-weight: 600; }
  @media (max-width: 60rem) { .protect-list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 36rem) { .protect-list { grid-template-columns: 1fr; } }

  .birds { background: color-mix(in oklab, var(--fern) 35%, var(--paper)); }
  .birds-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .birds-media { position: relative; }
  .birds-media :global(img) { border-radius: 999px 999px var(--radius-lg) var(--radius-lg); aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .spec {
    position: absolute;
    left: -8%;
    right: 10%;
    bottom: 8%;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: 0 20px 50px -20px color-mix(in oklab, var(--ink) 45%, transparent);
  }
  @media (max-width: 56rem) {
    .birds-grid { grid-template-columns: 1fr; }
    .spec { left: 4%; right: 4%; }
  }

  .coast {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: clamp(2rem, 6vw, 5rem);
    color: var(--paper);
    background:
      radial-gradient(30rem 20rem at 100% 0%, color-mix(in oklab, var(--sky) 40%, transparent), transparent 70%),
      linear-gradient(160deg, var(--kotare), var(--kotare-deep));
  }
  .coast .eyebrow { color: var(--kowhai); }
  .coast .lead { color: color-mix(in oklab, var(--paper) 88%, transparent); }
  .coast-copy { max-width: 42rem; }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .ticks li { display: flex; gap: 0.7rem; }
  .ticks li::before { content: "✓"; color: var(--kowhai); font-weight: 700; }

  .buffer-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .buffer-img :global(img) { border-radius: var(--radius-lg); aspect-ratio: 1; object-fit: cover; width: 100%; }
  .credit { margin-top: 0.7rem; font-size: var(--step--1); color: var(--muted); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 56rem) { .buffer-grid { grid-template-columns: 1fr; } }
</style>
