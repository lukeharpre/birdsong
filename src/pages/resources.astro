---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { newsletters, reports } from "../lib/content";

// Headlines about trapping and predators stay in the PDFs but aren't listed.
const offTopic = /trap|possum|stoat|ferret|weasel|mustelid|\brats?\b|rodent|bait|lure|predator|hub|kiwi|myna|\bcats?\b|cat-|feral|wasp|killer|pest (stats|control)|now listed pest/i;
const issues = newsletters.map((n) => ({
  ...n,
  title: n.title.replace(/\s*eNews$/, ""),
  topics: n.topics.filter((t) => !offTopic.test(t)).slice(0, 6),
}));
const years = [...new Set(issues.map((n) => n.title.slice(-4)))];
---
<Base title="Resources" description="Annual reports, every monthly eNews and the pest plant guide from Project Birdsong.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Resources</p>
      <h1>Reports, guides and every newsletter.</h1>
      <nav class="jump" aria-label="On this page">
        <a href="#guides" class="chip">Guides</a>
        <a href="#reports" class="chip">Annual reports</a>
        <a href="#newsletters" class="chip">Newsletters</a>
      </nav>
    </div>
  </section>

  <section id="guides" class="section-sm">
    <div class="wrap">
      <a href="/pest-plants" class="guide reveal">
        <span class="g-label">Field guide</span>
        <span class="g-title">Pest plants and how to beat them</span>
        <span class="g-body">How to recognise the weeds smothering native bush in Mahurangi West, and how to get rid of them.</span>
        <span class="link-arrow">Open the guide <Icon name="arrow" size={18} /></span>
      </a>
    </div>
  </section>

  <section id="reports" class="section reports-sec">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Annual reports</p>
        <h2>What we achieved each year.</h2>
        <p class="lead">Restoration projects, volunteer contributions, finances and the difference we’ve made.</p>
      </div>
      <ul class="reports reveal-stagger">
        {reports.map((r, i) => (
          <li style={`--i:${i}`}>
            <a href={r.pdf}>
              <span class="r-label">Annual report</span>
              <span class="r-year">{r.title}</span>
              <span class="r-dl"><Icon name="pdf" size={18} /> PDF</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="newsletters" class="section">
    <div class="wrap news-grid">
      <div class="news-intro stack" style="--space: 1.3rem">
        <p class="eyebrow">Newsletters</p>
        <h2>{issues.length} issues of the monthly eNews.</h2>
        <p class="lead">Planting days, bird counts, events, volunteer stories and ways to help.</p>
        <a class="btn sun" href="https://preview.mailerlite.io/forms/2346067/193744657051551642/share" rel="noopener">Subscribe <Icon name="arrow" /></a>
      </div>
      <div class="years">
        {years.map((y, i) => (
          <details name="news-year" open={i === 0}>
            <summary><span>{y}</span><span class="count">{issues.filter((n) => n.title.endsWith(y)).length} issues</span></summary>
            <ul class="issues">
              {issues.filter((n) => n.title.endsWith(y)).map((n) => (
                <li>
                  <a href={n.pdf} class="issue">
                    <span class="month">{n.title.replace(` ${y}`, "")}</span>
                    {n.topics.length > 0 && <span class="topics">{n.topics.join(" · ")}</span>}
                    <span class="dl"><Icon name="pdf" size={18} /></span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .jump a { text-decoration: none; transition: background-color 0.25s; }
  .jump a:hover { background: var(--green-tint); }

  .section-sm { padding-block: clamp(2rem, 5vw, 4rem); }
  .guide {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--green-tint) 45%, var(--paper));
    text-decoration: none;
    transition: transform 0.5s var(--ease-spring);
  }
  .guide:hover { transform: translateY(-4px); }
  .g-label { font-weight: 600; font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.12em; color: var(--green); }
  .g-title { font-family: var(--display); font-size: var(--step-3); font-weight: 600; line-height: 1.1; }
  .g-body { color: var(--ink-2); max-width: 40rem; }

  .reports-sec { background: var(--blue-tint); border-radius: var(--radius-lg); margin-inline: clamp(0.5rem, 1.5vw, 1.25rem); }
  .reports {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(12rem, 100%), 1fr));
    gap: 1rem;
  }
  .reports a {
    position: relative;
    display: grid;
    align-content: space-between;
    aspect-ratio: 3 / 4;
    padding: 1.5rem;
    border-radius: 0.5rem var(--radius-lg) var(--radius-lg) 0.5rem;
    background: var(--paper);
    text-decoration: none;
    box-shadow: inset 10px 0 0 var(--blue), 0 24px 40px -28px color-mix(in oklab, var(--ink) 50%, transparent);
    transition: transform 0.5s var(--ease-spring);
    transform-origin: 0 50%;
  }
  .reports li:nth-child(2) a { box-shadow: inset 10px 0 0 var(--green), 0 24px 40px -28px color-mix(in oklab, var(--ink) 50%, transparent); }
  .reports li:nth-child(3) a { box-shadow: inset 10px 0 0 var(--navy), 0 24px 40px -28px color-mix(in oklab, var(--ink) 50%, transparent); }
  .reports li:nth-child(4) a, .reports li:nth-child(5) a { box-shadow: inset 10px 0 0 var(--green-deep), 0 24px 40px -28px color-mix(in oklab, var(--ink) 50%, transparent); }
  .reports a:hover { transform: perspective(800px) rotateY(-12deg); }
  .r-label { font-weight: 600; font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.12em; color: var(--green); padding-left: 0.5rem; }
  .r-year { font-family: var(--display); font-size: var(--step-4); font-weight: 600; line-height: 1; padding-left: 0.5rem; }
  .r-dl { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; padding-left: 0.5rem; }
  @media (max-width: 56rem) { .reports { grid-template-columns: 1fr 1fr; } }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .news-intro { position: sticky; top: 7rem; }
  .news-intro h2 { font-size: var(--step-3); }
  @media (max-width: 60rem) { .news-grid { grid-template-columns: 1fr; } .news-intro { position: static; } }

  details {
    border-top: 1px solid var(--line);
  }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 1.1rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--display);
    font-size: var(--step-3);
    font-weight: 600;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+";
    font-family: var(--body);
    font-weight: 400;
    transition: transform 0.4s var(--ease-spring);
  }
  details[open] summary::after { transform: rotate(45deg); }
  summary .count { margin-left: auto; margin-right: 1rem; font-family: var(--body); font-size: var(--step--1); font-weight: 500; color: var(--muted); }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.5s var(--ease-out), content-visibility 0.5s allow-discrete;
  }
  details[open]::details-content { block-size: auto; }
  .issues { list-style: none; margin: 0; padding: 0 0 1.25rem; display: grid; gap: 0.4rem; }
  .issue {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .issue:hover { background: var(--paper-2); }
  .month { font-weight: 600; }
  .topics { color: var(--ink-2); font-size: var(--step--1); line-height: 1.5; }
  .dl { color: var(--blue-deep); }
  @media (max-width: 36rem) {
    .issue { grid-template-columns: 1fr auto; }
    .topics { grid-column: 1; }
    .dl { grid-row: 1; grid-column: 2; }
  }
</style>
