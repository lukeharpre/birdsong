---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import SongLine from "../components/SongLine.astro";
import StoryCard from "../components/StoryCard.astro";
import Campaign from "../components/Campaign.astro";
import { stories, pinned } from "../lib/content";
import { campaign } from "../lib/campaign";

const birds = [
  ["Kākā", "forest parrot"],
  ["Kererū", "wood pigeon"],
  ["Tūī", "honeyeater"],
  ["Kōtare", "kingfisher"],
  ["Kororā", "little penguin"],
  ["Matuku-hūrepo", "bittern"],
  ["Tītī", "Cook’s petrel"],
  ["Mātātā", "fernbird"],
  ["Pekapeka", "native bat"],
];

const work = [
  {
    title: "Understand",
    tag: "20 monitoring stations",
    body: "Volunteers count birds at 20 stations every season, listen for pekapeka and watch over the coast.",
    img: "2021-02-img_20201215_093739.jpg",
    alt: "Bird counters with binoculars on a picnic rug at the edge of the bush",
    colour: "var(--blue-tint)",
    href: "/our-work#understand",
  },
  {
    title: "Restore",
    tag: "Planting · weeding · regeneration",
    body: "We plant natives and clear the weeds that smother the bush, from Jamieson Bay to Huawai Bay.",
    img: "2025-08-group-pic_end-of-day.jpg",
    alt: "A group of volunteers at the end of a planting day",
    colour: "var(--green-tint)",
    href: "/our-work#restore",
  },
  {
    title: "Protect",
    tag: "16,000+ pest catches since 2019",
    body: "With Auckland Council we look after what has been restored, so it keeps feeding and sheltering birds.",
    img: "2025-05-native_daphne_foreshore.jpg",
    alt: "Native plants growing on the foreshore",
    colour: "var(--navy-tint)",
    href: "/our-work#protect",
  },
];

const latest = pinned;
---
<Base>
  <!-- ============================================================ hero -->
  <section class="hero">
    <div class="sun" aria-hidden="true"></div>

    <svg class="flock" viewBox="0 0 1400 700" aria-hidden="true" preserveAspectRatio="none">
      <defs>
        <symbol id="bird" viewBox="0 0 40 20"><path d="M2 12C8 6 14 6 20 12 26 6 32 6 38 12 32 9 26 10 20 15 14 10 8 9 2 12Z" /></symbol>
      </defs>
    </svg>
    <div class="birds" aria-hidden="true">
      <span class="b b1"><svg viewBox="0 0 40 20"><use href="#bird" /></svg></span>
      <span class="b b2"><svg viewBox="0 0 40 20"><use href="#bird" /></svg></span>
      <span class="b b3"><svg viewBox="0 0 40 20"><use href="#bird" /></svg></span>
    </div>

    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-in" style="--d:0">Mahurangi West · Aotearoa</p>
        <h1 class="hero-title">
          {["Bringing", "the", "birdsong", "back", "to", "the", "Mahurangi", "West", "Peninsula."].map((w, i) => (
            <><span class:list={["w", { accent: w === "birdsong" }]} style={`--d:${i + 1}`}>{w}</span>{" "}</>
          ))}
        </h1>
        <p class="lead hero-in" style="--d:10">
          Restoring native bird habitat across 3,500 hectares of Mahurangi West. Over 150 volunteers plant natives,
          clear the weeds that smother the bush and count the birds that come back.
        </p>
        <div class="cta hero-in" style="--d:11">
          <a href="/donate" class="btn">Donate <Icon name="arrow" /></a>
          <a href="/our-work" class="btn ghost">See our work</a>
        </div>
      </div>

      <div class="collage" aria-label="Volunteers restoring native habitat around Mahurangi West">
        <div class="ph arch">
          <Img name="2025-02-img_20240414_102615.jpg" alt="Volunteers planting on the edge of the estuary beside a Mahurangi West Pest flag" sizes="(min-width: 64rem) 34vw, 80vw" eager />
        </div>
        <div class="ph round">
          <Img name="2024-05-gill-cossey_nada-cottrell_grant-cossey.jpg" alt="Three volunteers planting flaxes on a bank above the water" sizes="(min-width: 64rem) 16vw, 40vw" eager />
        </div>
        <div class="ph pill">
          <Img name="2025-08-volunteer-paul-mulching-plants.jpg" alt="A volunteer mulching newly planted natives" sizes="(min-width: 64rem) 14vw, 36vw" />
        </div>
        <a class="badge" href="/stories/kaka-making-a-comeback-in-mahurangi-west">
          <svg viewBox="0 0 120 120" class="ring" aria-hidden="true">
            <defs><path id="circle" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs>
            <text><textPath href="#circle">Kākā are back · June bird count · Kākā are back · </textPath></text>
          </svg>
          <span class="badge-core">Read<br />more</span>
          <span class="visually-hidden">Kākā are making a comeback: read the story</span>
        </a>
      </div>
    </div>

    <SongLine seed={7} height={150} class="hero-song" label="A sonogram of birdsong" />
  </section>

  <!-- ========================================================= marquee -->
  <section class="marquee" aria-labelledby="for-h">
    <h2 id="for-h" class="for">Who we’re doing this for</h2>
    <div class="track">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy ? "true" : undefined}>
          {birds.map(([name, eng]) => (
            <li><span class="mi">{name}</span><span class="en">{eng}</span></li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- ========================================================== impact -->
  <section class="section impact">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Our impact</p>
        <h2>Small tasks, done by many hands, <em class="accent">add up.</em></h2>
      </div>
      <dl class="stats reveal-stagger">
        <div class="stat" style="--i:0">
          <dt>hectares restored and protected</dt>
          <dd><span data-count="3500">3,500</span></dd>
        </div>
        <div class="stat" style="--i:1">
          <dt>volunteers</dt>
          <dd><span data-count="150" data-suffix="+">150+</span></dd>
        </div>
        <div class="stat" style="--i:2">
          <dt>volunteer hours in 2025–26</dt>
          <dd><span data-count="6700" data-suffix="+">6,700+</span></dd>
        </div>
      </dl>
    </div>
  </section>

  {campaign && <Campaign {...campaign} />}

  <!-- ===================================================== what we do -->
  <section class="section work">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">What we do</p>
        <h2>Three ways we bring the birdsong back.</h2>
      </div>
      <ol class="deck">
        {work.map((w, i) => (
          <li class="slide" style={`--i:${i}; --c:${w.colour}`}>
            <div class="slide-inner">
              <div class="slide-copy">
                <span class="num">0{i + 1}</span>
                <p class="tag">{w.tag}</p>
                <h3>{w.title}</h3>
                <p>{w.body}</p>
                <a href={w.href} class="link-arrow">Learn more <Icon name="arrow" size={18} /></a>
              </div>
              <div class="slide-img">
                <Img name={w.img} alt={w.alt} sizes="(min-width: 60rem) 40vw, 100vw" />
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================================================ micro-volunteer -->
  <section class="section micro">
    <div class="wrap micro-grid">
      <div class="stack reveal" style="--space: 1.5rem">
        <p class="eyebrow">Micro-volunteering</p>
        <h2>Got half an hour?</h2>
        <p class="lead">
          We work on the principle that many hands make light work. Small, regular contributions keep our projects
          going without anyone feeling overloaded.
        </p>
        <a href="/get-involved" class="btn">Find your task <Icon name="arrow" /></a>
      </div>
      <ul class="clocks reveal-stagger">
        <li style="--i:0; --mins:30">
          <span class="dial"><span>30<small>min</small></span></span>
          <div><h3>Count birds</h3><p>Half an hour at your station, once a season.</p></div>
        </li>
        <li style="--i:1; --mins:60">
          <span class="dial"><span>1<small>hour</small></span></span>
          <div><h3>Join a weed café</h3><p>Weeding, mulching and watering natives with your neighbours.</p></div>
        </li>
        <li style="--i:2; --mins:60">
          <span class="dial"><span><Icon name="leaf" size={26} /></span></span>
          <div><h3>Join a planting day</h3><p>Help plant natives, from the Jamieson Bay esplanade to Huawai Bay.</p></div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ======================================================== together -->
  <section class="together">
    <div class="together-img reveal-scale">
      <Img name="2026-06-1000034899.jpg" alt="A large group of volunteers on a gravel road above Huawai Bay" sizes="100vw" />
    </div>
    <div class="wrap together-copy">
      <blockquote class="reveal">
        <p>“Control, monitor, adapt, enhance and repeat to protect Mahurangi West.”</p>
        <footer>Brian Bramell, Chair</footer>
      </blockquote>
    </div>
  </section>

  <!-- ========================================================= stories -->
  <section class="section">
    <div class="wrap">
      <div class="head-row reveal">
        <div class="section-head">
          <p class="eyebrow">Latest stories</p>
          <h2>News from the bush.</h2>
        </div>
        <a href="/stories" class="link-arrow">All {stories.length} stories <Icon name="arrow" size={18} /></a>
      </div>
      <div class="story-grid reveal-stagger">
        <StoryCard post={latest[0]} size="lg" index={0} />
        <div class="story-side">
          {latest.slice(1).map((p, i) => <StoryCard post={p} index={i + 1} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== partnership -->
  <section class="section iwi">
    <div class="wrap iwi-grid">
      <div class="iwi-img reveal">
        <Img name="2025-01-bb_iwipineproj2_crop.jpg" alt="Community members gathered at the iwi pine removal project" sizes="(min-width: 60rem) 40vw, 100vw" />
      </div>
      <div class="stack reveal" style="--space: 1.4rem">
        <p class="eyebrow">Mana whenua</p>
        <h2>Caring for the whenua, together.</h2>
        <p class="lead">
          Ngāti Maraeariki ki Mahurangi have ancestral ties to this land, including the pā sites of Maki and
          Korotangi, and have been part of the project since its early days.
        </p>
        <p>
          The Morehu and Roberts whānau have worked alongside the community on their land at Jamieson Bay and Opahi
          Bay.
        </p>
        <a href="/about#iwi" class="link-arrow">Our iwi partners <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="thanks" aria-labelledby="thanks-h">
    <div class="wrap">
      <h2 id="thanks-h" class="eyebrow">With thanks to</h2>
      <ul class="reveal-stagger">
        {["Ngāti Maraeariki ki Mahurangi", "Auckland Council", "Foundation North", "Predator Free NZ", "The Forest Bridge Trust", "Judith Williams Trust", "Pic’s Peanut Butter", "Blue Star Group", "Mahurangi Estates"].map((n, i) => (
          <li style={`--i:${i}`}>{n}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========================================================== donate -->
  <section class="donate-band">
    <div class="wrap donate-grid">
      <div class="stack" style="--space: 1.4rem">
        <h2 class="reveal">Help bring the birdsong back.</h2>
        <p class="lead reveal">
          Donations pay for bird, bat and coastal monitoring, native plants and planting days, weed control and the
          long-term care of restored areas.
        </p>
      </div>
      <div class="bank reveal">
        <p class="bank-label">Bank transfer to Mahurangi West Pest Inc.</p>
        <p class="acct">06-0483-0894183-00</p>
        <p class="ref">Reference: <strong>BBB</strong></p>
        <div class="bank-actions">
          <button class="btn" data-copy="06-0483-0894183-00">
            <span class="c-idle"><Icon name="copy" size={18} /> Copy account number</span>
            <span class="c-done"><Icon name="check" size={18} /> Copied</span>
          </button>
          <a href="/donate" class="link-arrow">Ways to give <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------- hero */
  .hero {
    position: relative;
    padding-top: clamp(7rem, 13vw, 10rem);
    isolation: isolate;
    overflow: clip;
    background:
      radial-gradient(50rem 40rem at 100% 0%, color-mix(in oklab, var(--blue-tint) 95%, transparent), transparent 65%),
      radial-gradient(40rem 30rem at 0% 100%, color-mix(in oklab, var(--paper-2) 100%, transparent), transparent 70%);
  }
  .sun {
    position: absolute;
    z-index: -1;
    width: clamp(18rem, 40vw, 38rem);
    aspect-ratio: 1;
    right: -6vw;
    top: -8vw;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, var(--paper), var(--blue-tint) 60%);
    filter: blur(2px);
    opacity: 0.85;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sun { animation: breathe 9s ease-in-out infinite alternate; }
  }
  @keyframes breathe {
    to { transform: scale(1.08) translate(-2%, 3%); }
  }
  .flock { position: absolute; width: 0; height: 0; }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: 1.6rem;
  }
  .hero-title {
    font-size: clamp(2.9rem, 1.3rem + 5.4vw, 6.6rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .hero-title .w { display: inline-block; }
  .hero-title .accent { font-weight: 450; padding-right: 0.06em; }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-title .w,
    .hero-in {
      animation: word-in 1.1s var(--ease-out) both;
      animation-delay: calc(0.15s + var(--d) * 0.08s);
    }
  }
  @keyframes word-in {
    from { opacity: 0; transform: translateY(0.6em) rotate(4deg); filter: blur(10px); }
  }

  /* collage */
  .collage {
    position: relative;
    aspect-ratio: 1 / 1.08;
    max-width: 38rem;
    width: 100%;
    justify-self: end;
  }
  .ph {
    position: absolute;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px color-mix(in oklab, var(--ink) 45%, transparent);
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .arch {
    inset: 0 18% 8% 6%;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
  }
  .round {
    width: 40%;
    aspect-ratio: 1;
    right: 0;
    bottom: 0;
    border-radius: 50%;
    border: 6px solid var(--paper);
  }
  .pill {
    width: 28%;
    aspect-ratio: 3 / 5;
    left: -4%;
    bottom: 2%;
    border-radius: 999px;
    border: 6px solid var(--paper);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ph {
      animation: ph-in 1.4s var(--ease-out) both;
    }
    .arch { animation-delay: 0.2s; }
    .round { animation-delay: 0.55s; }
    .pill { animation-delay: 0.7s; }
    @supports (animation-timeline: scroll()) {
      .round, .pill, .badge {
        animation: ph-in 1.4s var(--ease-out) both, drift linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 100vh;
      }
      .round { animation-delay: 0.55s, 0s; }
      .pill { animation-delay: 0.7s, 0s; --drift: -6rem; }
      .badge { --drift: -9rem; animation-delay: 0.9s, 0s; }
      .arch :global(img) {
        animation: zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }
  @keyframes ph-in {
    from { opacity: 0; transform: translateY(3rem) scale(0.92); clip-path: inset(30% 0 0 0 round 999px); }
    to { clip-path: inset(0 0 0 0 round 0); }
  }
  @keyframes drift {
    to { translate: 0 var(--drift, -3.5rem); }
  }
  @keyframes zoom {
    to { transform: scale(1.12); }
  }

  .badge {
    position: absolute;
    top: 6%;
    right: 2%;
    width: clamp(6.5rem, 11vw, 8.5rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--blue-deep);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 20px 40px -18px color-mix(in oklab, var(--blue-deep) 80%, transparent);
    transition: transform 0.5s var(--ease-spring);
  }
  .badge:hover { transform: scale(1.08) rotate(-6deg); }
  .ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font: 600 10.5px/1 var(--body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ring { animation: spin 18s linear infinite; }
  }
  @keyframes spin { to { transform: rotate(1turn); } }
  .badge-core {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1;
    text-align: center;
  }

  /* birds on a CSS motion path */
  .birds { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .b {
    position: absolute;
    top: 0;
    left: 0;
    width: 34px;
    color: var(--ink);
    offset-path: path("M-80 260 C 240 120, 520 340, 820 180 S 1300 60, 1700 160");
    offset-rotate: auto;
    offset-distance: 0%;
    opacity: 0;
  }
  .b svg { width: 100%; fill: currentColor; }
  .b2 { width: 24px; offset-path: path("M-60 330 C 300 220, 600 380, 900 250 S 1400 140, 1700 230"); }
  .b3 { width: 18px; offset-path: path("M-40 200 C 260 90, 560 250, 860 130 S 1300 40, 1700 100"); }
  @media (prefers-reduced-motion: no-preference) {
    .b {
      animation: fly 16s linear infinite;
    }
    .b svg { animation: flap 0.5s ease-in-out infinite alternate; transform-origin: center; }
    .b2 { animation-delay: 1.2s; }
    .b3 { animation-delay: 2s; }
    .b2 svg { animation-duration: 0.42s; }
  }
  @keyframes fly {
    0% { offset-distance: 0%; opacity: 0; }
    6%, 80% { opacity: 0.85; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes flap {
    to { transform: scaleY(0.35); }
  }

  .hero :global(.hero-song) {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-inline: var(--gutter);
  }

  @media (max-width: 60rem) {
    .hero-grid { grid-template-columns: 1fr; }
    .collage { justify-self: center; max-width: 30rem; margin-top: 1rem; }
    .pill { left: 0; }
    .b { display: none; }
  }

  /* -------------------------------------------------------- marquee */
  .marquee {
    background: var(--ink);
    color: var(--paper);
    padding-block: 1.4rem;
    overflow: hidden;
    rotate: -1.2deg;
    margin-inline: -2vw;
    margin-top: -0.5rem;
    contain: paint;
    position: relative;
    z-index: 3;
  }
  .for {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    padding-inline: calc(2vw + var(--gutter)) 2.5rem;
    background: linear-gradient(90deg, var(--ink) 75%, transparent);
    font-family: var(--body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-tint);
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .for { position: static; padding: 0 0 0.8rem calc(2vw + var(--gutter)); background: none; }
  }
  .track {
    display: flex;
    width: max-content;
  }
  .track ul {
    display: flex;
    gap: 3rem;
    list-style: none;
    margin: 0;
    padding: 0 1.5rem;
  }
  .track li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    white-space: nowrap;
  }
  .track li::after {
    content: "✦";
    color: var(--green-tint);
    margin-left: 2.4rem;
    font-size: 1rem;
  }
  .mi {
    font-family: var(--display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-style: italic;
  }
  .en {
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--paper) 60%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .track { animation: marquee 50s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* --------------------------------------------------------- impact */
  .impact {
    background:
      radial-gradient(40rem 30rem at 0% 0%, color-mix(in oklab, var(--green-tint) 35%, transparent), transparent 70%),
      var(--paper);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    min-height: 13rem;
  }
  .stat:nth-child(1) { background: var(--navy); color: #fff; }
  .stat:nth-child(2) { background: var(--blue-tint); }
  .stat:nth-child(3) { background: color-mix(in oklab, var(--green-tint) 60%, var(--paper)); }
  dt {
    order: 2;
    font-weight: 600;
    font-size: var(--step-0);
  }
  dd {
    order: 1;
    margin: 0;
    font-family: var(--display);
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 48rem) {
    .stats { grid-template-columns: 1fr; }
    .stat { min-height: 9rem; }
  }

  /* ----------------------------------------------------------- work */
  .work { padding-bottom: clamp(2rem, 5vw, 4rem); }
  .deck {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .slide {
    position: sticky;
    top: calc(6rem + var(--i) * 1.25rem);
